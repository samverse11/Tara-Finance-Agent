{
  "name": "tara-finance-agent",
  "version": "1.0.0",
  "description": "AI-powered finance agent",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:dev": "tsx src/index.ts",
    "build": "tsc",
    "db:push": "drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:indexes": "tsx scripts/run-indexes.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:all": "tsx scripts/ingest.ts --all",
    "verify": "tsx scripts/verify-ingest.ts",
    "test:queries": "tsx scripts/test-queries.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@mastra/core": "^1.41.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
